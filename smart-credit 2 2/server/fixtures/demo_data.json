    },
    {
      "id": 2,
      "title": "Mandatory T&C checkbox",
      "customer_id": "CUS-001",
      "qr_ref": "QR-261016-2004",
      "expect": "Pay Now / Pay Later stay locked until the single T&C box is ticked (server rejects method selection without it)"
    },
    {
      "id": 3,
      "title": "Amount below / above Pay Later range",
      "customer_id": "CUS-001",
      "qr_ref": "QR-261016-1830",
      "expect": "980K and 95M are blocked from Pay Later with an explanation; Pay Now still possible"
    },
    {
      "id": 4,
      "title": "Sufficient profile, no CIC, no documents",
      "customer_id": "CUS-007",
      "qr_ref": "QR-261016-1505",
      "expect": "No CIC history but verified profile -> APPROVED without document request"
    },
    {
      "id": 5,
      "title": "Poor profile -> supporting documents",
      "customer_id": "CUS-002",
      "qr_ref": "QR-261016-0915",
      "expect": "RF-02/RF-03 -> documents requested -> upload -> MANUAL_REVIEW (no auto-approval)"
    },
    {
      "id": 6,
      "title": "Missing information -> resume",
      "customer_id": "CUS-006",
      "qr_ref": "QR-261016-2110",
      "expect": "INCOMPLETE -> provide profile -> re-assessed -> APPROVED"
    },
    {
      "id": 7,
      "title": "Third-party consent (thin file)",
      "customer_id": "CUS-005",
      "qr_ref": "QR-261016-1240",
      "expect": "INSUFFICIENT_EVIDENCE -> contextual e-wallet consent pop-up -> allow -> EV-3P -> APPROVED; decline -> documents or manual review"
    },
    {
      "id": 8,
